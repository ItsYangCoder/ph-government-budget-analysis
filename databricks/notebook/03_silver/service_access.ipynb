   "source": [
    "## 9. Check coverage\n",
    "Available and missing counts must equal the Silver total. Rerun unchanged inputs to confirm zero MERGE inserts and updates.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "inputWidgets": {},
     "nuid": "230d617c-3379-4b5e-8729-153ac42b3c91",
     "showTitle": false,
     "tableResultSettingsMap": {},
     "title": ""
    }
   },
   "outputs": [],
   "source": [
    "%sql\n",
    "SELECT ASSERT_TRUE(\n",
