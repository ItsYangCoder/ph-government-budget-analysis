# For CLI use only. Do not commit real credentials.
pondolens:
  target: dev
  outputs:
    dev:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DBT_ACCESS_TOKEN') }}"
      catalog: pondolens
      schema: dev_silver
      threads: 1
